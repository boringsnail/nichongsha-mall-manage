// 你宠啥商城数据模型 —— SQLite（开发） / MySQL（上线）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = "mysql://root:@localhost:3306/nichongsha_shadow"
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

// 售后类型（对齐淘宝：只退款不退货 / 退货退款）
enum AfterSaleType {
  // 仅退款：没收到货（未发货、物流停滞）或与商家协商一致，不需要把货寄回
  REFUND_ONLY
  // 退货退款：已收到货，要把货寄回给商家，商家确认收货后退款
  RETURN_REFUND
}

// 售后状态机（对齐淘宝售后流程）：
//
//  REFUND_ONLY：  PENDING ──商家同意──→ AGREED ──退款──→ REFUNDING ──→ COMPLETED
//                    └──商家拒绝──→ REJECTED ──用户可再次申请/申请平台介入
//
//  RETURN_REFUND：PENDING ──商家同意──→ WAIT_RETURN ──用户填单号──→ RETURNING
//                    └──商家拒绝──→ REJECTED        ──商家确认收货──→ REFUNDING ──→ COMPLETED
//
// 任何非终态都可以被用户主动撤销（CANCELLED）。
enum AfterSaleStatus {
  // 待商家处理
  PENDING
  // 商家已同意（仅退款：可直接退款；退货退款：进入待买家退货）
  AGREED
  // 待买家退货（仅退货退款）
  WAIT_RETURN
  // 买家已退货，等待商家收货
  RETURNING
  // 退款中（已向微信提交退款，等微信回调）
  REFUNDING
  // 售后完成（退款到账）
  COMPLETED
  // 商家拒绝
  REJECTED
  // 买家撤销
  CANCELLED
}

// 售后单
model AfterSale {
  id                     Int             @id @default(autoincrement())
  // 售后单号：AS + yyMMddHHmmss + 4 位随机，供用户/客服沟通使用
  afterSaleNo            String          @unique @db.VarChar(32)
  orderId                Int
  orderNo                String          @db.VarChar(32)
  userId                 Int
  type                   AfterSaleType
  status                 AfterSaleStatus @default(PENDING)
  // 申请原因（枚举值，展示文案在小程序侧）与用户补充说明
  reason                 String          @db.VarChar(32)
  description            String?         @db.VarChar(512)
  // 凭证图片 JSON 数组（URL），最多 6 张
  images                 String          @default("[]") @db.VarChar(2048)
  // 申请退款金额（分）。不超过订单实付金额
  refundAmount           Int
  // 实际已退金额（分）：部分退款/多次退款时逐笔累加，退款成功才写
  refundedAmount         Int             @default(0)
  // 微信退款单号（退款成功后写入）
  refundNo               String?         @db.VarChar(64)
  // 商家拒绝原因
  rejectReason           String?         @db.VarChar(256)
  // 买家退货物流（仅退货退款）
  returnLogisticsCompany String?         @db.VarChar(64)
  returnTrackingNo       String?         @db.VarChar(64)
  // 时间轴
  agreedAt               DateTime?
  returnedAt             DateTime? // 买家填写退货单号的时间
  receivedAt             DateTime? // 商家确认收到退货
  refundedAt             DateTime? // 退款成功
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  // 同一订单可能有多笔售后（部分退款场景），但列表查询几乎都按订单过滤
  @@index([orderNo])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([orderId, status])
}

// 埋点事件：小程序行为上报（转化漏斗数据源）
// eventType: app_launch | product_view | add_cart | create_order | pay_success
model UserEvent {
  id        Int      @id @default(autoincrement())
  eventType String   @db.VarChar(32)
  // 登录用户可关联；未登录访客仅 sessionId
  userId    Int?
  openid    String?  @db.VarChar(64)
  // 匿名会话标识：小程序 onLaunch 生成并本地持久化（uuid）
  sessionId String?  @db.VarChar(64)
  productId Int?
  skuId     Int?
  orderNo   String?  @db.VarChar(32)
  amount    Int?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@index([productId])
}

enum ProductStatus {
  ON
  OFF
}

model User {
  id         Int         @id @default(autoincrement())
  openid     String      @unique
  nickname   String?
  avatarUrl  String?
  phone      String?
  createdAt  DateTime    @default(now())
  addresses  Address[]
  carts      Cart[]
  orders     Order[]
  afterSales AfterSale[]
  searches   SearchLog[]
  loginLogs  LoginLog[]
}

/// 登录记录：小程序每次 wx.login 换会话时写一条。
///
/// 以前只在 JWT 里签发会话，登录这件事本身不留痕，商家问「这个用户多久来一次」
/// 完全答不上来。这里只记「谁、什么时候、从哪、什么设备」，不记密码/凭证。
/// userId 允许为空（用户被删后历史记录仍保留，onDelete: SetNull）。
model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  /// 登录时的 openid 快照：用户被删了也还能看出是谁
  openid    String   @db.VarChar(64)
  /// 登录方式：cloud（云托管注入 openid）/ code（code2Session）/ dev（开发期 mock）
  via       String?  @db.VarChar(16)
  /// 来源端：miniprogram / admin（目前只记小程序，字段留着以后扩展）
  source    String   @default("miniprogram") @db.VarChar(16)
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(256)
  /// 这次登录是否顺带注册了新用户
  isNewUser Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("LoginLog")
}

/// 搜索记录：小程序每次搜索上报一条，用于「搜索分析」。
///
/// 刻意不建外键约束到 User（userId 可空）：未登录也能搜，且埋点不该因为
/// 用户被删而连带失败。userId 只作为聚合维度用。
model SearchLog {
  id          Int      @id @default(autoincrement())
  /// 搜索的人；未登录为 null
  userId      Int?
  /// 搜索词（去掉首尾空白，最长 64）
  keyword     String   @db.VarChar(64)
  /// 这次搜索命中的商品数；0 表示「搜了但没结果」，是最有价值的一类
  resultCount Int      @default(0)
  /// 来源：miniprogram / admin（后台暂不埋点，留字段便于以后区分）
  source      String   @default("miniprogram") @db.VarChar(16)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([keyword])
  @@map("SearchLog")
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  receiverName String
  phone        String
  province     String
  city         String
  district     String
  detail       String
  isDefault    Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  icon      String?
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  subtitle    String?
  description String?       @db.VarChar(2048)
  coverImage  String        @db.VarChar(512)
  // 轮播图 JSON 数组字符串：多张图 URL 远超默认 VARCHAR(191)，必须显式加长
  images      String        @default("[]") @db.VarChar(2048)
  categoryId  Int
  status      ProductStatus @default(ON)
  salesCount  Int           @default(0)
  // 冗余最低价：SKU 价变更时同步维护（SQLite 不支持 relation min 排序，供 C 端 sort=price 下推 SQL）
  minPrice    Int           @default(0)
  category    Category      @relation(fields: [categoryId], references: [id])
  skus        Sku[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Sku {
  id         Int         @id @default(autoincrement())
  productId  Int
  specName   String
  price      Int
  stock      Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id])
  cartItems  Cart[]
  orderItems OrderItem[]
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  skuId     Int
  quantity  Int      @default(1)
  checked   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id])
  sku       Sku      @relation(fields: [skuId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, skuId])
}

model Order {
  id               Int         @id @default(autoincrement())
  orderNo          String      @unique
  userId           Int
  totalAmount      Int
  // 顾客实付的运费（分）：下单时算出来，计入总营业额
  freight          Int         @default(0)
  // 我们实际付给骑手/快递的配送成本（分）：商家在订单管理里录入。
  // 和 freight 是两个方向的钱，所以单独一列；净营业额要把它扣掉。
  deliveryCost     Int         @default(0)
  status           OrderStatus @default(PENDING_PAYMENT)
  // 收货地址 JSON 快照：默认 VARCHAR(191) 会截断，显式加长
  addressSnapshot  String      @db.VarChar(1024)
  remark           String?     @db.VarChar(512)
  paidAt           DateTime?
  // 微信支付交易号（支付成功回调/查单时写入，用于对账与退款）
  paymentNo        String?
  shippedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  logisticsCompany String?
  trackingNo       String?
  // 物流模式（对齐微信 upload_shipping_info.logistics_type）：
  //   1 快递发货 / 2 同城配送 / 3 虚拟商品（本项目不用）/ 4 用户自提
  // 历史数据默认按快递处理，故给默认值 1 而不是可空。
  logisticsType    Int         @default(1)
  // 订单维度汇总的售后状态（避免列表页为每单再查一次 AfterSale）
  afterSaleStatus  String?     @db.VarChar(16)
  // 该订单已退款总额（分）：用于校验超额退款
  refundedAmount   Int         @default(0)
  user             User        @relation(fields: [userId], references: [id])
  items            OrderItem[]
  afterSales       AfterSale[]
  createdAt        DateTime    @default(now())
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  skuId       Int
  productId   Int
  productName String
  specName    String
  coverImage  String
  price       Int
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  sku         Sku     @relation(fields: [skuId], references: [id])
}

model Merchant {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  nickname     String?
  createdAt    DateTime @default(now())
}

/// 键值配置表：公告、售后超时规则这类「商家自己会改、但不该进环境变量」的设置。
/// 刻意用 key-value 而不是宽表：每加一个配置项不用再写迁移，值统一存字符串，
/// 由 configService 负责类型转换与默认值兜底。
model AppConfig {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("AppConfig")
}
