# 你宠啥 · 后端环境变量模板
# 复制为 .env 后填入实际值（.env 不入库）

# ---------- 数据库（下面三种写法任选其一）----------
# ① 完整连接串（推荐，最不容易配错；空密码也写得出：mysql://root:@host:3306/db）
DATABASE_URL="mysql://root:password@localhost:3306/nichongsha"
# ② 只有内网地址时：DATABASE_URL 写 host:port，账号密码单独给
# DATABASE_URL="10.0.0.1:3306"
# DB_USER="root"
# DB_PASS="password"
#    也可把地址拆成 DB_HOST + DB_PORT（必须成对；一旦配置，
#    优先级高于 DATABASE_URL 里的地址和 MYSQL_ADDRESS）
# DB_HOST="10.0.0.1"
# DB_PORT="3306"
# ③ 绑定云托管/CloudBase 内置 MySQL 时，平台会自动注入
#    MYSQL_ADDRESS / MYSQL_USERNAME / MYSQL_PASSWORD，无需再配上面任何变量。
# 库名：DB_NAME 优先，其次 MYSQL_DATABASE，默认 nichongsha。
# DB_NAME="nichongsha"
# MYSQL_DATABASE="nichongsha"
#
# 配错不会带着半截配置启动：进程会打印 [fatal] 数据库配置有误 + 修复提示后退出。

# 数据库排障日志开关（默认关闭）：打开后启动时会打印
# `数据库账号 <账号>@<host:port>/<库名>（配置来源：…）` 与各数据库变量是否已设置（均不含密码）。
# 只在排查连接/配置问题时临时打开，用完删掉。
# DB_CONFIG_DEBUG=1

# 服务器端口（云托管会自动注入 PORT，通常 8080）
PORT=3000

# 服务器监听地址（默认 0.0.0.0，容器部署必须）
# HOST=0.0.0.0

# Node 环境：development | production
NODE_ENV=development

# JWT 密钥（生产环境必须 ≥16 字符，不得为默认值）
JWT_SECRET="change-me-to-a-strong-random-string"

# JWT 过期时间（默认 7 天）
JWT_EXPIRES_IN=7d

# 微信登录（生产必须配置真实 AppID/Secret）
WX_APPID=""
WX_APPSECRET=""

# 跨域白名单（逗号分隔）
# 管理后台：本地开发 Vite 代理（同源无需）；上线填 admin 域名
ADMIN_ORIGINS="http://localhost:5173"
# 小程序请求 origin（开发者工具为 devtools://，真机为 https://servicewechat.com/...）
MINIPROGRAM_ORIGINS=""

# 订单未支付超时（分钟）
ORDER_EXPIRE_MINUTES=30

# ---------- 微信云托管登录（生产推荐，零出网）----------
# 小程序用 wx.cloud.callContainer 调服务时，平台会注入 x-wx-openid / x-wx-source，
# 服务端直接用它建会话：不需要容器访问 api.weixin.qq.com，也不需要 AppSecret。
# 仅在需要关闭该信任时设为 0。
# TRUST_WX_HEADERS=1

# ---------- 微信支付 ----------
#
# 两种接入方式，用 PAY_PROVIDER 选择：mock | wechatpay（云调用）| wechatpay-direct（APIv3 直连）
#
# 【重要】小程序提供**实物交易服务**时，微信会禁用「云调用支付」，接口报：
#   ret 268500896「暂不支持使用云调用支付能力，请使用工作流接入微信支付」
# （要求接入订单发货管理）。此时请改用 wechatpay-direct（直连不受该限制）；
# 发货后服务端会自动上报「订单发货管理」（见 shippingService）。
#
# --- 方式一：微信云托管「云调用」支付（虚拟/服务类小程序适用）---
# 免证书、免签名：POST http://api.weixin.qq.com/_/pay/unifiedOrder，由平台代转发微信支付。
# 前置：① 有商户号 ② 商户号已关联本小程序 AppID ③ 云托管控制台 → 设置 → 其他设置 →
#       微信支付配置 → 绑定商户号（超管在微信确认）④ 商户平台「我的授权产品」确认 JSAPI/退款
# WXPAY_SUB_MCHID=1001619740           # 微信支付商户号（sub_mch_id）
# WXPAY_SUB_APPID=wxce86198b133baa5e   # 小程序 AppID，默认取 WX_APPID，可省略
# WXPAY_ENV_ID=prod-xxxxxxxxxxxx       # 云托管环境 ID（支付结果回调需要）
# WXPAY_NOTIFY_SERVICE=ncspetmall      # 接收支付结果回调的服务名（本服务）
# WXPAY_NOTIFY_PATH=/api/pay/notify    # 回调路径，默认 /api/pay/notify
#
# --- 方式二：微信支付 APIv3 直连（推荐；实物交易必选）---
# 用商户自己的 API 证书签名直连 api.mch.weixin.qq.com，不经过平台服务商链路。
# 取值位置：微信支付商户平台 → 账户中心 → API安全
# PAY_PROVIDER=wechatpay-direct
# WXPAY_MCHID=1001619740                        # 商户号
# WXPAY_SERIAL_NO=xxxxxxxxxxxxxxxxxxxxxxxxxxxx  # 商户 API 证书序列号
# WXPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"   # apiclient_key.pem（支持 \n）
# WXPAY_API_V3_KEY=32位APIv3密钥
# WXPAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n"   # 微信支付公钥（回调验签）
# WXPAY_PLATFORM_PUBLIC_KEY_ID=PUB_KEY_ID_xxxxxxxx               # 微信支付公钥 ID
# WXPAY_PLATFORM_CERT="-----BEGIN CERTIFICATE-----\n..."          # 或用平台证书（二选一）
# WXPAY_NOTIFY_URL=https://<公网域名>/api/pay/notify              # 支付结果通知地址（必须 HTTPS）
# PUBLIC_BASE_URL=https://ncspetmall-326900-12-1504359859.sh.run.tcloudbase.com   # 默认回调地址前缀

# 埋点接口 /api/track 的每分钟限流阈值（默认 600，按 IP+事件类型计数）
# TRACK_RATE_LIMIT=600
